<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Downtify" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- SplashScreen API: the logo on the app's own background, then straight into Home. -->
    <style name="Theme.Downtify.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Downtify</item>
    </style>
</resources>
